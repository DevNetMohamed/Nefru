PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nefru

# Required in production. Use a long random secret.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin used by CORS and email links
FRONTEND_URL=http://localhost:5173
# development: lax | cross-site production frontend/backend: none
COOKIE_SAME_SITE=lax

# Google Cloud OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

MAILER_HOST=smtp.gmail.com
MAILER_PORT=465
MAILER_EMAIL=your-email@example.com
MAILER_PASSWORD=your-app-password

EMAIL_ADMIN=admin@example.com
PASSWORD_ADMIN=Admin123456
EMAIL_TOURIST=tourist@example.com
PASSWORD_TOURIST=Tourist123456
EMAIL_GUIDE=guide@example.com
PASSWORD_GUIDE=Guide123456
